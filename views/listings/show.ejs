<% layout("/layouts/boilerplate")%>
<body>
    <h3>Listing Details :</h3>
    <ul> 
        <li> <%= Listing.title %></li>
        <li> <%= Listing.description %></li>
        <li> &#8377;<%=  Listing.price.toLocaleString("en-IN") %></li> / night
        <li> <%= Listing.location  %></li>
        <li> <%= Listing.country %></li>
    </ul>
    <br>
    <a href="/listing/<%= Listing._id %>/edit">Edit this Listing </a>
    <br><br>
    <!-- <form method="post" action="/listing/ ?_method=Delete">
        <button>Delete</button>
    </form> -->
    <form method="POST" action="/listing/<%= Listing._id %>?_method=DELETE">
        <button>Delete</button>
    </form>
</body>
